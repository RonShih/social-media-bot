# Copy to .env (gitignored). Fill in from LINE Developer Console → Messaging API channel.

# Channel basics
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Webhook server
WEBHOOK_HOST=127.0.0.1
WEBHOOK_PORT=8000

# Group / room prefix filter — bot only responds when message starts with one of these.
# Comma-separated. Ignored for 1:1 chats (bot always responds).
LINE_GROUP_PREFIXES=@editor,/sma,editor

# Headless Claude
# Prefer absolute path (output of `which claude`) — PATH may not resolve in launchd / cloudflared environments.
CLAUDE_BIN=claude
# Per-message claude -p timeout in seconds. Default for normal commands.
CLAUDE_TIMEOUT_SECONDS=600
# Timeout for slow commands. Auto-applied when the prompt mentions /weekly-plan,
# /publish-from-plan, /draft-post, /publish-now, "weekly plan", or "週計劃". Default 1h.
CLAUDE_TIMEOUT_SLOW_SECONDS=3600

# L1 conversation buffer: number of recent messages injected into prompt per request
L1_RECENT_N=20
